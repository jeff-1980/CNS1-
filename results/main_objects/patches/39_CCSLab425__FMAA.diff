+"""[audit] Driver for object 39 (registry: results/main_objects/registry/39_*.md).
+Runs the authors' main.py as __main__ (runpy, defaults) once per seed 0..9 (AUDIT_SEED replaces their seed 1).
+The hook in adv_train_process.model_evaluation records their own target-test accuracy/loss per adversarial epoch;
+AUDIT_FINAL receives best_acc. Run with cwd = the repo (relative ./datasets, ./save_dir). Needs
+PYTHONPATH=~/audit_cns/code and AUDIT_RECORD_DIR."""
+import argparse, json, os, runpy, sys, time
+REPO = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, REPO)
+import train_process_module.adv_train_process as ATP
+from audit.main.epoch_record import Recorder
+
+p = argparse.ArgumentParser()
+p.add_argument("--seeds", default="0-9")
+p.add_argument("--adv_epochs", type=int, default=None)
+a = p.parse_args()
+lo, hi = map(int, a.seeds.split("-")) if "-" in a.seeds else (int(a.seeds),) * 2
+
+for s in range(lo, hi + 1):
+    rec = Recorder(obj="39", group="FMAA|CWRU 1hp->SBDS 1K", seed=s, select_split=None, report_split="test",
+                   note="epoch = adversarial epoch; acc = authors' batch-mean target accuracy rounded to 4 d.p.")
+    st = {"best": 0.0}
+
+    def hook(ep, acc, loss):
+        rec.log(ep, "test", acc, loss)
+        if acc >= st["best"]:   # authors' rule
+            st["best"] = acc; rec.author_pick(ep)
+
+    ATP.AUDIT_HOOK = hook
+    final = {}
+    sys.argv = ["main.py"] + (["--n_epochs_3", str(a.adv_epochs)] if a.adv_epochs else [])
+    t0 = time.time()
+    runpy.run_path(os.path.join(REPO, "main.py"), init_globals=dict(AUDIT_SEED=s, AUDIT_FINAL=lambda v: final.update(v=float(v))),
+                   run_name="__main__")
+    ATP.AUDIT_HOOK = None
+    rec.finish(final.get("v"))
+    print(json.dumps(dict(seed=s, seconds=round(time.time() - t0, 1), author_epoch=rec.d["author_epoch"],
+                          reported=final.get("v"), check=rec.d["author_check"])), flush=True)
