+"""[audit] Driver for object 11 (registry: results/main_objects/registry/11_*.md).
+Same calls as HETPM_auto.py for one task (JNU 0 -> 1), author defaults, 10 unseeded repeats.
+Needs PYTHONPATH=~/audit_cns/code, AUDIT_RECORD_DIR, AUDIT_DATA_DIR."""
+import argparse, json, os, sys, time
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+p = argparse.ArgumentParser()
+p.add_argument("--repeats", default="0-9")
+p.add_argument("--epochs", type=int, default=None)
+a = p.parse_args()
+sys.argv = [sys.argv[0], "--data_name", "JNUB"] + (["--max_epoch", str(a.epochs)] if a.epochs else [])
+from HETPM_auto import parse_args
+from utils.train_util_HETPM import train_utils_auto
+from audit.main.epoch_record import Recorder
+args = parse_args()
+lo, hi = map(int, a.repeats.split("-")) if "-" in a.repeats else (int(a.repeats),) * 2
+for r in range(lo, hi + 1):
+    t0 = time.time()
+    trainer = train_utils_auto(args)
+    trainer.setup([[0], [1]])
+    trainer.audit_rec = Recorder(obj="11", group="HETPM|JNU 0->1", seed=r, select_split=None, report_split="test",
+                                 note=f"unseeded repeat {r}; F2 head; epochs={args.max_epoch}")
+    f1, f2, avg = trainer.train([[0], [1]], r)
+    print(json.dumps(dict(repeat=r, epochs=args.max_epoch, seconds=round(time.time() - t0, 1), last_F1=f1, last_F2=f2, last_Avg=avg,
+                          check=trainer.audit_rec.d.get("author_check"))), flush=True)
