+"""[audit] Driver for object 83 (registry: results/main_objects/registry/83_yushi1006__FLSHGAT-for-semi-supervised-fault-diagnosis.md).
+Runs the authors' "train hypergraph for UoO.py" (runpy, cwd = repo) with defaults (FD, 4096-point windows, 150 per
+class / 100 train, last class 300 / 200, 1 labelled sample per class, 200 full-batch epochs) 10 times unseeded (only
+random.seed(100) for the labelled-sample choice). Their test graph is evaluated after every epoch and selects their
+'best' model (strict >); the hook records their test accuracy and their test loss (sum of their three terms);
+AUDIT_FINAL receives the accuracy of their last strictly-better saved model. Needs PYTHONPATH with ~/audit_cns/code,
+AUDIT_RECORD_DIR."""
+import argparse, json, os, runpy, shutil, sys, time
+REPO = os.path.dirname(os.path.abspath(__file__))
+p = argparse.ArgumentParser()
+p.add_argument("--repeats", default="0-9")
+p.add_argument("--epochs", type=int, default=None)   # smoke only
+p.add_argument("--data_dir", required=True)
+p.add_argument("--work", required=True)
+a = p.parse_args()
+lo, hi = map(int, a.repeats.split("-")) if "-" in a.repeats else (int(a.repeats),) * 2
+os.chdir(REPO); sys.path.insert(0, REPO)
+from audit.main.epoch_record import Recorder
+import utils.train_hypergraph_utils as TU
+
+for r in range(lo, hi + 1):
+    ck = os.path.join(a.work, f"ckpt_r{r}"); shutil.rmtree(ck, ignore_errors=True)
+    rec = Recorder(obj="83", group="FLSHGAT|uOttawa time-varying 5-class 1 label/class", seed=r, select_split=None,
+                   report_split="test", note="unseeded repeat; test graph selects their best model; test loss = their "
+                                             "loss1+loss2+loss3 on the test graph")
+    final = {}
+
+    def hook(ep, acc, loss, strict_best):
+        rec.log(ep, "test", float(acc), loss)
+        if strict_best: rec.author_pick(ep)
+
+    TU.AUDIT_HOOK = hook
+    TU.AUDIT_FINAL = lambda v: final.update(v=float(v))
+    sys.argv = ["train hypergraph for UoO.py", "--data_dir", a.data_dir, "--checkpoint_dir", ck]
+    if a.epochs: sys.argv += ["--max_epoch", str(a.epochs)]
+    t0 = time.time()
+    runpy.run_path(os.path.join(REPO, "train hypergraph for UoO.py"), run_name="__main__")
+    rec.finish(final.get("v"))
+    shutil.rmtree(ck, ignore_errors=True)
+    print(json.dumps(dict(repeat=r, seconds=round(time.time() - t0, 1), author_epoch=rec.d["author_epoch"],
+                          reported=final.get("v"), check=rec.d["author_check"])), flush=True)
