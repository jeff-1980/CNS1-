+"""[audit] Driver for object 15 (registry: results/main_objects/registry/15_*.md).
+Calls the authors' train.main(snr=-10, ..., 'white', device) as their __main__ does, 10 unseeded repeats.
+Run with cwd = a work dir containing AWTL-DDFN1/N15_M07_F10 (symlink). Needs PYTHONPATH=~/audit_cns/code, AUDIT_RECORD_DIR."""
+import argparse, json, os, sys, time
+REPO = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, REPO)
+import torch
+import train as T
+from audit.main.epoch_record import Recorder
+
+p = argparse.ArgumentParser()
+p.add_argument("--repeats", default="0-9")
+p.add_argument("--epochs", type=int, default=None)
+a = p.parse_args()
+lo, hi = map(int, a.repeats.split("-")) if "-" in a.repeats else (int(a.repeats),) * 2
+dev = torch.device("cuda")
+for r in range(lo, hi + 1):
+    rec = Recorder(obj="15", group="AWT-DDFN|PU N15_M07_F10 white -10dB", seed=r, select_split="val", report_split="test",
+                   note=f"unseeded repeat {r}")
+    T.AUDIT_REC = rec
+    if a.epochs:   # smoke only: shorten the authors' 300 epochs via the config dict literal is not possible -> patch range
+        T.AUDIT_EPOCHS = a.epochs
+    t0 = time.time()
+    T.main(-10, f"AWTL-DDFN1/result/white/-10/{r}/", "white", dev)
+    T.AUDIT_REC = None
+    print(json.dumps(dict(repeat=r, seconds=round(time.time() - t0, 1), author_epoch=rec.d["author_epoch"],
+                          check=rec.d.get("author_check"), f1=rec.d.get("author_reported_f1"))), flush=True)
