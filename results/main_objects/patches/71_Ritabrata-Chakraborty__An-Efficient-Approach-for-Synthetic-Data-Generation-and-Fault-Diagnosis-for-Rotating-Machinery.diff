+"""[audit] Driver for object 71 (registry: results/main_objects/registry/71_*.md).
+Executes the code cells of the authors' Final.ipynb in order in one namespace (cwd = a work copy without the shipped
+GAN / classifier checkpoints), 10 times unseeded (the notebook seeds only its sequence shuffle, random.seed(42)). All code cells run (cell 15 defines load_generator, used by cell 22).
+Per repeat: ACWGAN-GP trained from scratch (50 epochs), then their three classifiers (real 100 per fault class +
+0 / 400 / 900 generated, 20 epochs each), evaluated on their test set.
+Hook after their per-epoch validation records their val accuracy/loss and, isolated, test accuracy/loss;
+AUDIT_FINAL receives their printed test accuracy. Needs PYTHONPATH=~/audit_cns/code, AUDIT_RECORD_DIR."""
+import argparse, glob, json, os, re, sys, time
+import matplotlib
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+plt.show = lambda *a, **k: plt.close("all")
+import torch, torch.nn as nn
+from audit.main.epoch_record import Recorder
+from audit.torch_utils import isolate
+
+p = argparse.ArgumentParser()
+p.add_argument("--repeats", default="0-9")
+p.add_argument("--gan-epochs", type=int, default=None)   # smoke only
+p.add_argument("--cls-epochs", type=int, default=None)   # smoke only
+a = p.parse_args()
+lo, hi = map(int, a.repeats.split("-")) if "-" in a.repeats else (int(a.repeats),) * 2
+REPO = os.path.dirname(os.path.abspath(__file__))
+nb = json.load(open(os.path.join(REPO, "Final.ipynb"), encoding="utf-8"))
+SKIP = set()
+cells = [(i, "".join(c["source"])) for i, c in enumerate(nb["cells"]) if c["cell_type"] == "code" and i not in SKIP]
+assert [i for i, _ in cells] == [2, 4, 6, 7, 9, 11, 13, 15, 17, 19, 20, 21, 22, 24, 26, 27], [i for i, _ in cells]
+
+
+def sub(s, old, new):
+    assert s.count(old) == 1, old
+    return s.replace(old, new)
+
+
+src = dict(cells)
+if a.gan_epochs:
+    src[2] = sub(src[2], "epoch_num = 50 #", f"epoch_num = {a.gan_epochs} #")
+if a.cls_epochs:
+    src[2] = sub(src[2], "classifier_epochs = 20\n", f"classifier_epochs = {a.cls_epochs}\n")
+src[26] = sub(src[26], "        val_accuracies.append(val_accuracy)\n",
+              "        val_accuracies.append(val_accuracy)\n"
+              "        if AUDIT_HOOK: AUDIT_HOOK(samples, epoch + 1, discriminator, val_loss / len(val_loader), val_accuracy)  # [audit]\n")
+src[27] = sub(src[27], "    accuracy = calculate_accuracy(discriminator, loader, device=device)\n",
+              "    accuracy = calculate_accuracy(discriminator, loader, device=device)\n"
+              "    if AUDIT_FINAL: AUDIT_FINAL(num_samples, accuracy)  # [audit]\n")
+code = [(i, compile(src[i], f"Final.ipynb[cell {i}]", "exec")) for i in src]
+GROUPS = {100: "Real100+Gen0", 500: "Real100+Gen400", 1000: "Real100+Gen900"}
+TASK = "CWRU DE 10-class (N 1000, faults 100 real)"
+
+for r in range(lo, hi + 1):
+    for f in glob.glob("Models/GAN_Models/*.pth") + glob.glob("Models/Classifiers/*.pth"):
+        os.remove(f)   # never load shipped / previous-repeat checkpoints
+    recs = {}
+
+    def hook(samples, ep, model, val_loss, val_acc):
+        if samples not in recs:
+            recs[samples] = Recorder(obj="71", group=f"{GROUPS[samples]}|{TASK}", seed=r, select_split="val",
+                                     report_split="test",
+                                     note="unseeded repeat; GAN retrained per repeat; acc as proportion (author percent / 100); author saves "
+                                          "state_dict() by reference, so the 'best val' checkpoint is the last epoch")
+            recs[samples].d["intended_best_val_epoch"] = None
+            recs[samples]._best = 0.0
+        rec = recs[samples]
+        dev = next(model.parameters()).device
+        with isolate([model], dev):
+            tl, ta = g["evaluate_model"](model, g["test_loader"], nn.CrossEntropyLoss(), dev)
+        model.train()
+        rec.log(ep, "val", float(val_acc) / 100, float(val_loss))
+        rec.log(ep, "test", float(ta) / 100, tl / len(g["test_loader"]))
+        rec.author_pick(ep)   # effective rule: the saved weights are the final ones
+        if val_acc > rec._best:
+            rec._best = val_acc; rec.d["intended_best_val_epoch"] = ep
+
+    final = {}
+    g = {"__name__": "__main__", "AUDIT_HOOK": hook, "AUDIT_FINAL": lambda n, v: final.update({n: float(v) / 100})}
+    t0 = time.time()
+    for i, c in code:
+        t1 = time.time(); exec(c, g)
+        print(f"[audit] repeat {r} cell {i} {time.time() - t1:.0f}s", flush=True)
+    for n, rec in recs.items():
+        rec.finish(final.get(n))
+        print(json.dumps(dict(repeat=r, group=GROUPS[n], seconds=round(time.time() - t0, 1),
+                              author_epoch=rec.d["author_epoch"], intended=rec.d["intended_best_val_epoch"],
+                              reported=final.get(n), check=rec.d["author_check"])), flush=True)
