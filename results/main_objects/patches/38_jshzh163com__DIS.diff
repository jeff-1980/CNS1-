+"""[audit] Python port of the authors' matlab/SQV_text_to_mat.m + get_speed.m (rule d154119: light deterministic
+preprocessing -> Python). For every condition folder and every REC*_ch2.txt (sorted, as MATLAB dir() lists them):
+  vibration = column 2 from row 17 of REC<id>_ch2.txt;  speed = -(column 2 from row 17 of REC<id>_ch3.txt)
+  index = all i (1-based) with speed(i) >= 5 and speed(i+1) <= 5      (get_speed with threshold 5)
+  if index non-empty: data = vibration(index(1):index(end)) saved as <condition>_<k>.mat (k = 1, 2, ... in order)
+The public archive names the normal folder 'NC'; the authors' script and prepare_sqv.py use condition 'N'.
+No resampling, so no filter-sensitivity check is needed."""
+import argparse, glob, os, re
+import numpy as np
+from scipy.io import savemat
+
+p = argparse.ArgumentParser()
+p.add_argument("--root", required=True)
+p.add_argument("--out", required=True)
+a = p.parse_args()
+FS = 25.6e3
+FOLDERS = {"IF_1": "IF_1", "IF_2": "IF_2", "IF_3": "IF_3", "OF_1": "OF_1", "OF_2": "OF_2", "OF_3": "OF_3", "N": "NC"}
+
+
+def col2(path):
+    return np.loadtxt(path, skiprows=16, usecols=1, dtype=np.float64)
+
+
+for condition, folder in FOLDERS.items():
+    os.makedirs(a.out, exist_ok=True)
+    files = sorted(glob.glob(os.path.join(a.root, folder, "REC*_ch2.txt")))
+    k = 0
+    for f in files:
+        rid = re.search(r"REC(\d+)_ch2\.txt$", f).group(1)
+        vib = col2(f)
+        spd = -col2(os.path.join(a.root, folder, f"REC{rid}_ch3.txt"))
+        idx = np.nonzero((spd[:-1] >= 5) & (spd[1:] <= 5))[0] + 1      # 1-based like MATLAB
+        if idx.size:
+            first, last = int(idx[0]), int(idx[-1])
+            k += 1
+            savemat(os.path.join(a.out, f"{condition}_{k}.mat"),
+                    dict(data=vib[first - 1:last].reshape(-1, 1), fs=FS, record_id=rid, condition=condition,
+                         first_sample=first, last_sample=last))
+            print(condition, k, rid, len(vib), first, last, flush=True)
+        else:
+            print(condition, "skip", rid, len(vib), flush=True)
