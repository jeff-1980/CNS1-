+"""[audit] Driver for object 38 (registry: results/main_objects/registry/38_*.md).
+Runs the authors' train.py as __main__ (runpy) with --dataset SQV --data_dir <prepared> --seed s (defaults otherwise).
+At each of the authors' evaluation points the hook records their valid / target accuracy (mean over loaders, as they
+compute it) and, isolated, the cross-entropy on the same loaders; the authors' selection rule incl. its tie rule
+marks author_pick. 'epoch' = evaluation point 1..25. Needs PYTHONPATH=~/audit_cns/code, AUDIT_RECORD_DIR."""
+import argparse, json, os, runpy, sys, time
+REPO = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, REPO)
+import numpy as np, torch
+import torch.nn.functional as F
+from audit.main.epoch_record import Recorder
+from audit.torch_utils import isolate
+
+p = argparse.ArgumentParser()
+p.add_argument("--seeds", default="0-9")
+p.add_argument("--max_epoch", type=int, default=None)
+p.add_argument("--data_dir", required=True)
+p.add_argument("--out", required=True)
+a = p.parse_args()
+lo, hi = map(int, a.seeds.split("-")) if "-" in a.seeds else (int(a.seeds),) * 2
+real_stdout, real_stderr = sys.stdout, sys.stderr
+
+
+@torch.no_grad()
+def mean_ce(alg, loaders, dev):
+    vals = []
+    for ld in loaders:
+        tot, n = 0.0, 0
+        for d in ld:
+            x, y = d[0].to(dev).float(), d[1].to(dev).long()
+            tot += F.cross_entropy(alg.predict(x), y, reduction="sum").item(); n += len(x)
+        vals.append(tot / n)
+    return float(np.mean(vals))
+
+
+for s in range(lo, hi + 1):
+    rec = Recorder(obj="38", group="DIS|SQV test_env 0", seed=s, select_split="val", report_split="test",
+                   note="epoch = evaluation point (epochs 0,5,...,115,119); acc = authors' mean over loaders")
+    st = dict(n=0, best_valid=0.0, target=0.0)
+
+    def hook(epoch, alg, eval_loaders, names, accs):
+        st["n"] += 1; n = st["n"]
+        dev = next(alg.parameters()).device
+        with isolate([alg], dev):
+            alg.eval()
+            vl = mean_ce(alg, [eval_loaders[i] for i in names["valid"]], dev)
+            tl = mean_ce(alg, [eval_loaders[i] for i in names["target"]], dev)
+        rec.log(n, "val", accs["valid"], vl)
+        rec.log(n, "test", accs["target"], tl)
+        rec.d.setdefault("eval_epoch", {})[str(n)] = int(epoch)
+        if accs["valid"] > st["best_valid"]:
+            st["best_valid"] = accs["valid"]; st["target"] = accs["target"]; rec.author_pick(n)
+        if accs["valid"] >= st["best_valid"] and accs["target"] >= st["target"]:
+            st["target"] = accs["target"]; rec.author_pick(n)
+
+    final = {}
+    out = os.path.join(a.out, f"seed{s}")
+    sys.argv = [os.path.join(REPO, "train.py"), "--dataset", "SQV", "--data_dir", a.data_dir, "--seed", str(s),
+                "--output", out] + (["--max_epoch", str(a.max_epoch)] if a.max_epoch else [])
+    t0 = time.time()
+    cwd = os.getcwd(); os.chdir(REPO)
+    try:
+        runpy.run_path(os.path.join(REPO, "train.py"), init_globals=dict(AUDIT_HOOK=hook, AUDIT_FINAL=lambda v: final.update(v=float(v))),
+                       run_name="__main__")
+    finally:
+        os.chdir(cwd); sys.stdout, sys.stderr = real_stdout, real_stderr
+    rec.finish(final.get("v"))
+    print(json.dumps(dict(seed=s, seconds=round(time.time() - t0, 1), n_eval=st["n"], author_epoch=rec.d["author_epoch"],
+                          reported=final.get("v"), check=rec.d["author_check"])), flush=True)
