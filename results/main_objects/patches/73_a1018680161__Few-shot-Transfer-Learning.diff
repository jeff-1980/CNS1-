@@ -0,0 +1,79 @@
+"""[audit] Driver for object 73 (registry: results/main_objects/registry/73_*.md).
+README commands (1 shot, 5-way, FFT input, 1-D model), 10 unseeded repeats (the code seeds only the file order):
+  Meta-transfer  : main_meta_transfer.py -s 1   (code default 5 episodes, test every 5 -> one evaluation)
+  Feature-transfer: main_finetune.py -s 1 -u 0 ; Full-finetune: main_finetune.py -s 1 -u 4 (both use the encoder
+                    pretrained in the same repeat: the authors' script caches it and the -u 4 run loads it)
+  Direct         : mian_direct.py -s 1
+Each script runs as __main__ (runpy). The hooks record their test accuracy at each evaluation (meta: per test point;
+finetune / direct: per fine-tune iteration, with an isolated test CE). Reported = their logged 'final accuracy'
+(meta: last test accuracy; finetune / direct: mean of the last 10 iterations).
+Run with cwd = repo (tempdata/ cache and result dirs are written there). Needs PYTHONPATH=~/audit_cns/code, AUDIT_RECORD_DIR."""
+import argparse, glob, json, math, os, runpy, sys, time
+REPO = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, REPO)
+import numpy as np, torch, torch.nn.functional as F
+from audit.main.epoch_record import Recorder
+from audit.torch_utils import isolate
+
+p = argparse.ArgumentParser()
+p.add_argument("--repeats", default="0-9")
+p.add_argument("--groups", default="meta,ft,direct")
+p.add_argument("--pretrain", type=int, default=None)   # smoke only
+a = p.parse_args()
+lo, hi = map(int, a.repeats.split("-")) if "-" in a.repeats else (int(a.repeats),) * 2
+dev = torch.device("cuda")
+TASK = "PU N09M07F10 artificial->natural 5-way 1-shot"
+
+
+def run(script, argv, group, r, rule):
+    rec = Recorder(obj="73", group=f"{group}|{TASK}", seed=r, select_split=None, report_split="test",
+                   note=f"unseeded repeat; epoch = {'meta episode' if 'meta' in script else 'fine-tune iteration'}; reported = {rule}")
+    st = {"accs": []}
+
+    def hook(ep, acc, ctx):
+        loss = float("nan")
+        if ctx is not None:
+            enc, clf, loader = ctx
+            with isolate([enc, clf], dev):
+                enc.eval(); clf.eval(); tot = n = 0
+                with torch.no_grad():
+                    for x, y in loader:
+                        out = clf(enc(x.cuda().float())); y = y.cuda().long()
+                        tot += F.cross_entropy(out, y, reduction="sum").item(); n += y.numel()
+                loss = tot / n
+        rec.log(ep, "test", float(acc), loss)
+        st["accs"].append(float(acc)); rec.d["last"] = ep
+
+    final = {}
+    sys.argv = [script] + argv
+    t0 = time.time()
+    runpy.run_path(os.path.join(REPO, script), run_name="__main__",
+                   init_globals=dict(AUDIT_HOOK=hook, AUDIT_FINAL=lambda v: final.update(v=float(v))))
+    rec.author_pick(rec.d["last"])
+    if "meta" in script:
+        rec.finish(final["v"])
+    else:   # their figure is the mean of the last 10 iterations, not one epoch
+        rec.finish(None)
+        rec_mean = float(np.mean(st["accs"][-10:]))
+        rec.d["author_rule"] = "mean of the last 10 fine-tune iterations"
+        rec.d["author_reported"] = final["v"]
+        rec.d["author_check_mean10"] = dict(recorded=rec_mean, reported=final["v"], abs_diff=abs(rec_mean - final["v"]),
+                                            matches=math.isclose(rec_mean, final["v"], abs_tol=1e-9))
+        rec._dump()
+    print(json.dumps(dict(group=group, repeat=r, seconds=round(time.time() - t0, 1), author_epoch=rec.d["author_epoch"],
+                          reported=final["v"], check=rec.d.get("author_check") or rec.d.get("author_check_mean10"))), flush=True)
+
+
+for r in range(lo, hi + 1):
+    if "meta" in a.groups:
+        run("main_meta_transfer.py", ["-s", "1"], "Meta-transfer", r, "last test accuracy")
+    if "ft" in a.groups:
+        # their pretrained-encoder cache ('.\\result_finetune' + '/models_save/episode<E>.pkl' on Linux) from the
+        # previous repeat -> removed so each repeat pretrains anew (within a repeat, -u 4 reuses -u 0's encoder as in their workflow)
+        for f in glob.glob(os.path.join(REPO, ".\\result_finetune", "models_save", "*.pkl")):
+            os.remove(f)
+        extra = (["-e", str(a.pretrain)] if a.pretrain else [])
+        run("main_finetune.py", ["-s", "1", "-u", "0"] + extra, "Feature-transfer", r, "mean of last 10 iterations")
+        run("main_finetune.py", ["-s", "1", "-u", "4"] + extra, "Full-finetune", r, "mean of last 10 iterations")
+    if "direct" in a.groups:
+        run("mian_direct.py", ["-s", "1"], "Direct", r, "mean of last 10 iterations")
