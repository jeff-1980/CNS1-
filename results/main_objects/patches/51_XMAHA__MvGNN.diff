+"""[audit] Driver for object 51 (registry: results/main_objects/registry/51_*.md).
+Calls the authors' train.main() (README command, configs/seu_paper.json, data/seu.npz) once per seed 0..9 via
+their own --seed option (which also sets their data split, as in their 10-trial protocol). The hook after their
+per-epoch validation accuracy records it with, isolated, the validation cross-entropy and the test accuracy / CE;
+AUDIT_FINAL receives their test accuracy of the validation-selected checkpoint.
+Needs PYTHONPATH=~/audit_cns/code, AUDIT_RECORD_DIR."""
+import argparse, json, os, sys, time
+REPO = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, REPO)
+import torch, torch.nn.functional as F
+import train as T
+from audit.main.epoch_record import Recorder
+from audit.torch_utils import isolate
+
+p = argparse.ArgumentParser()
+p.add_argument("--seeds", default="0-9")
+p.add_argument("--epochs", type=int, default=None)
+p.add_argument("--data", default=os.path.expanduser("~/audit_ext/data/seu51/seu.npz"))
+p.add_argument("--work", default=os.path.expanduser("~/audit_ext/work51"))
+a = p.parse_args()
+lo, hi = map(int, a.seeds.split("-")) if "-" in a.seeds else (int(a.seeds),) * 2
+
+
+@torch.no_grad()
+def acc_ce(model, loader, device):
+    correct = total = 0; ce = 0.0
+    for batch in loader:
+        batch = batch.to(device)
+        logits = model(batch.time_x, batch.freq_x, batch.edge_index, batch.batch)
+        correct += int((logits.argmax(1) == batch.y).sum()); total += batch.num_graphs
+        ce += F.cross_entropy(logits, batch.y, reduction="sum").item()
+    return correct / total, ce / total
+
+
+for s in range(lo, hi + 1):
+    rec = Recorder(obj="51", group="MvGNN|SEU 9-class", seed=s, select_split="val", report_split="test",
+                   note="80/10/10 stratified split set by the seed (authors' --seed); early stopping patience 5 on val acc")
+    st = {"best": -1.0}
+
+    def hook(epoch, model, val_acc, val_loader, test_loader, device):
+        with isolate([model], device):
+            model.eval()
+            _, val_loss = acc_ce(model, val_loader, device)
+            test_acc, test_loss = acc_ce(model, test_loader, device)
+        rec.log(epoch, "val", float(val_acc), val_loss)
+        rec.log(epoch, "test", test_acc, test_loss)
+        if val_acc > st["best"]:          # authors' checkpoint rule (strict >)
+            st["best"] = val_acc; rec.author_pick(epoch)
+
+    final = {}
+    T.AUDIT_HOOK = hook
+    T.AUDIT_FINAL = lambda v: final.update(v=float(v))
+    sys.argv = ["train.py", "--config", os.path.join(REPO, "configs/seu_paper.json"), "--data", a.data,
+                "--output", os.path.join(a.work, f"seu_seed{s}.pt"), "--device", "cuda", "--seed", str(s)] + \
+               (["--epochs", str(a.epochs)] if a.epochs else [])
+    t0 = time.time()
+    T.main()
+    T.AUDIT_HOOK = T.AUDIT_FINAL = None
+    rec.finish(final.get("v"))
+    print(json.dumps(dict(seed=s, seconds=round(time.time() - t0, 1), author_epoch=rec.d["author_epoch"],
+                          reported=final.get("v"), check=rec.d["author_check"])), flush=True)
