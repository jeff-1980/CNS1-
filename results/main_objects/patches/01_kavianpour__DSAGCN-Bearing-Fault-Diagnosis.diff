+"""[audit] Driver for object 01: groups x seeds on CWRU B->D with author defaults.
+Same call as run_method(): fit_model(cfg, ds, DEEP_METHODS[m], 1, 3, epochs, seed).
+Needs PYTHONPATH=~/audit_cns/code and AUDIT_RECORD_DIR set."""
+import argparse, json, time
+from config import cfg
+from datasets import get_dataset
+from methods import DEEP_METHODS
+from train import fit_model
+from audit.main.epoch_record import Recorder
+
+p = argparse.ArgumentParser()
+p.add_argument("--methods", default="DSAGCN,GC-MMD,GC-MKMMD,GC-CORAL")
+p.add_argument("--seeds", default="0-9")
+p.add_argument("--epochs", type=int, default=None)
+p.add_argument("--data_root", required=True)
+a = p.parse_args()
+cfg.data_root = a.data_root
+lo, hi = map(int, a.seeds.split("-")) if "-" in a.seeds else (int(a.seeds), int(a.seeds))
+ds = get_dataset("cwru", cfg)
+epochs = a.epochs or ds["epochs"]
+for m in a.methods.split(","):
+    for s in range(lo, hi + 1):
+        rec = Recorder(obj="01", group=f"{m}|CWRU B->D", seed=s, select_split=None, report_split="test",
+                       note=f"epochs={epochs}")
+        t0 = time.time()
+        _, _, _, final_acc, best_acc = fit_model(cfg, ds, DEEP_METHODS[m], 1, 3, epochs, s, rec=rec)
+        print(json.dumps(dict(method=m, seed=s, epochs=epochs, final=final_acc, best=best_acc,
+                              seconds=round(time.time() - t0, 1), check=rec.d.get("author_check"))), flush=True)
