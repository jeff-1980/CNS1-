+"""[audit] Driver for object 74 (registry: results/main_objects/registry/74_*.md).
+Runs the authors' train.py as __main__ (runpy) with the README command '-s 1 -b 15 -e 100 -g 0' (5-way 1-shot,
+N09_M07_F10 -> N15_M01_F10), seeds 0..9 replacing their set_seed(3). The hook records their test accuracy at each
+evaluation (every 5 episodes, 1000 test episodes); reported = their 'Final average accuracy' (mean of the test
+accuracies at episodes 85, 90, 95, 100). Run with cwd = repo (./data tree). Needs PYTHONPATH=~/audit_cns/code, AUDIT_RECORD_DIR."""
+import argparse, json, math, os, runpy, sys, time
+REPO = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, REPO)
+import numpy as np
+from audit.main.epoch_record import Recorder
+
+p = argparse.ArgumentParser()
+p.add_argument("--seeds", default="0-9")
+p.add_argument("--episodes", type=int, default=100)
+a = p.parse_args()
+lo, hi = map(int, a.seeds.split("-")) if "-" in a.seeds else (int(a.seeds),) * 2
+
+for s in range(lo, hi + 1):
+    rec = Recorder(obj="74", group="FDR-RelationNet|PU N09M07F10->N15M01F10 5-way 1-shot", seed=s, select_split=None,
+                   report_split="test", note="epoch = training episode (test every 5); reported = mean of the test accuracies at episodes 85-100")
+    st = {"pts": {}}
+
+    def hook(ep, acc):
+        rec.log(ep, "test", float(acc), float("nan"))
+        st["pts"][ep] = float(acc); rec.d["last"] = ep
+
+    final = {}
+    sys.argv = ["train.py", "-s", "1", "-b", "15", "-e", str(a.episodes), "-g", "0"]
+    t0 = time.time()
+    runpy.run_path(os.path.join(REPO, "train.py"), run_name="__main__",
+                   init_globals=dict(AUDIT_HOOK=hook, AUDIT_FINAL=lambda v: final.update(v=float(v)), AUDIT_SEED=s))
+    rec.author_pick(rec.d["last"])
+    rec.finish(None)
+    mine = float(np.sum([v for k, v in st["pts"].items() if k > 80]) / 4)     # their finalsum / 4
+    rec.d["author_rule"] = "mean of the test accuracies at episodes > 80 (finalsum / 4)"
+    rec.d["author_reported"] = final["v"]
+    rec.d["author_check_mean4"] = dict(recorded=mine, reported=final["v"], abs_diff=abs(mine - final["v"]),
+                                       matches=math.isclose(mine, final["v"], abs_tol=1e-9))
+    rec._dump()
+    print(json.dumps(dict(seed=s, seconds=round(time.time() - t0, 1), reported=final["v"], check=rec.d["author_check_mean4"])), flush=True)
