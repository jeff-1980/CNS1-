+    sec = float(sec)
+    if sec < 60:
+        return f"{sec:.2f}s"
+    m, s = divmod(sec, 60)
+    if m < 60:
+        return f"{int(m)}m{s:05.2f}s"
+    h, m = divmod(m, 60)
+    return f"{int(h)}h{int(m):02d}m{s:05.2f}s"
