+def _tf_zscore_per_segment(x, eps=POST_ZSCORE_EPS):
+    mu = tf.reduce_mean(x, axis=1, keepdims=True)
+    sd = tf.math.reduce_std(x, axis=1, keepdims=True) + eps
+    return (x - mu) / sd
