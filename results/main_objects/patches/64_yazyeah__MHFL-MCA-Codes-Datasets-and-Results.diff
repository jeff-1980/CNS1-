+"""[audit] Driver for object 64 (registry: results/main_objects/registry/64_*.md).
+Executes one of the authors' KAIST scripts (MHCNN_KAIST.py = MHFL-MCA, MSF-DFormer_KAIST.py, CFFN_KAIST.py) with
+source-level edits only (the executed code is written next to this driver as audit_<script> for the patch record):
+  - the YOUR_* path placeholders (README: 'replace with your own paths') -> local KAIST copy and an output dir;
+  - SAMPLE_RANGE range(5, 31) -> range(5, 6): the N = 5 task only (jeff 2026-10-23);
+  - per-run seed n_train*100 + run_idx -> audit seed run_idx - 1 (0..9);
+  - Stage 3 (noise study) not run;
+  - one line attaching the audit Keras callback, one line passing their 2 Nm / 4 Nm accuracies to the driver.
+MHCNN: Stage 1 (Optuna, 30 trials on the 0 Nm tune split) runs as written. MHCNN / MSF-DFormer: the callback is
+attached to the Stage-2 end-to-end fit. CFFN (jeff: final-classifier stage only): the callback is attached to the
+softmax classifier fit on CCA-fused features (after the two-branch EDCN fit and CCA), and evaluates the full pipeline
+(their feature extractors + CCA + classifier) on the test set each classifier epoch.
+Test inputs per epoch = exactly their eval noise: MHCNN / MSF 0 dB with RandomState(seed + 999); CFFN RandomState(seed + 10)
+(2 Nm) / (seed + 20) (4 Nm). Needs PYTHONPATH=~/audit_cns/code, AUDIT_RECORD_DIR."""
+import argparse, json, os, re, sys, time
+import numpy as np
+from audit.main.epoch_record import Recorder
+
+p = argparse.ArgumentParser()
+p.add_argument("--script", default="MHCNN_KAIST.py")
+p.add_argument("--group", default="MHFL-MCA")
+p.add_argument("--repeats", type=int, default=10)
+p.add_argument("--epochs", type=int, default=None)      # smoke only
+p.add_argument("--trials", type=int, default=None)      # smoke only
+p.add_argument("--out", default=None)
+a = p.parse_args()
+OUT = a.out or os.path.expanduser(f"~/audit_ext/work64/out_{a.group}")
+REPO = os.path.dirname(os.path.abspath(__file__))
+CODE = os.path.join(REPO, "Codes", "Codes for KAIST")
+DATA = os.path.expanduser("~/audit_ext/data/kaist64")
+SCRIPT = os.path.join(CODE, a.script)
+src = open(SCRIPT, encoding="utf-8").read()
+CFFN = a.script.startswith("CFFN")
+
+
+def sub(old, new, count=1):
+    global src
+    assert src.count(old) == count, (old, src.count(old))
+    src = src.replace(old, new)
+
+
+def resub(pat, rep, count=1):
+    global src
+    n = len(re.findall(pat, src, flags=re.M))
+    assert n == count, (pat, n)
+    src = re.sub(pat, rep, src, flags=re.M)
+
+
+n = src.count('r"YOUR_TEMP_PATH"')
+if n:
+    sub('r"YOUR_TEMP_PATH"', repr(os.path.join(OUT, "tmp")), n)
+for k in ("0NM", "2NM", "4NM"):
+    sub(f'r"YOUR_VIB_MAT_DIR_{k}"', repr(os.path.join(DATA, "vibration")))
+sub('r"YOUR_CUR_TDMS_DIR"', repr(os.path.join(DATA, "current")))
+sub('r"YOUR_OUTPUT_DIR"', repr(OUT))
+resub(r"^SAMPLE_RANGE = range\(5, 31\).*$", "SAMPLE_RANGE = range(5, 6)  # [audit] N = 5 task only")
+resub(r"^(\s+)seed = n_train \* 100 \+ run_idx$", r"\1seed = run_idx - 1  # [audit] seeds 0..9")
+resub(r"^(\s+)run_noise_study(_same_model)?\((.*)\)$", r"\1pass  # [audit] Stage 3 not run")
+resub(r"^REPEAT_TIMES = 10$", f"REPEAT_TIMES = {a.repeats}")
+if not CFFN:
+    resub(r"^(            )t_fit0 = time\.perf_counter\(\)$",
+          r"\1if AUDIT_CB: callbacks.append(AUDIT_CB(run_idx, seed, base_model, x2_v, x2_c, y2, x4_v, x4_c, y4))  # [audit]\n\1t_fit0 = time.perf_counter()")
+    resub(r'^(            )buf\["acc_2"\]\.append\(acc2\); (.*)$',
+          r'\1buf["acc_2"].append(acc2); \2\n\1if AUDIT_FINAL: AUDIT_FINAL(run_idx, seed, acc2, acc4)  # [audit]')
+else:
+    resub(r"^(                )feat_v, feat_c, cca_params, clf, train_time, _ = train_one_run_cffn\($",
+          r"\1AUDIT_CTX.update(run_idx=run_idx, seed=seed, x2=(x2_v, x2_c, y2), x4=(x4_v, x4_c, y4))  # [audit]\n\1feat_v, feat_c, cca_params, clf, train_time, _ = train_one_run_cffn(")
+    sub("    hist_clf = clf.fit(\n        fused_tr, ytr,\n",
+        "    hist_clf = clf.fit(\n        fused_tr, ytr,\n"
+        "        callbacks=([AUDIT_CB(feat_v, feat_c, cca_params)] if (AUDIT_CB and AUDIT_CTX) else None),  # [audit]\n")
+    resub(r'^(                )acc2_list\.append\(m2\["acc"\]\); f12_list\.append\(m2\["f1"\]\); (.*)$',
+          r'\1acc2_list.append(m2["acc"]); f12_list.append(m2["f1"]); \2\n\1if AUDIT_FINAL: AUDIT_FINAL(run_idx, seed, m2["acc"], m4["acc"])  # [audit]')
+if a.epochs:
+    resub(r"^(EPOCHS(_FULL)?) = \d+$", rf"\1 = {a.epochs}")
+    if src.count("            epochs=30,\n") == 1:
+        sub("            epochs=30,\n", f"            epochs={a.epochs},\n")
+if a.trials:
+    resub(r"^SEARCH_TRIALS = \d+$", f"SEARCH_TRIALS = {a.trials}")
+os.makedirs(os.path.join(OUT, "tmp"), exist_ok=True)
+with open(os.path.join(REPO, f"audit_{a.script}"), "w", encoding="utf-8") as f:
+    f.write(src)
+
+import tensorflow as tf
+recs = {}
+G = {"__name__": "__main__", "__file__": SCRIPT}
+AUDIT_CTX = {}
+
+
+def new_rec(run_idx, seed):
+    rec = Recorder(obj="64", group=f"{a.group}|KAIST 0->2Nm N=5", seed=seed, select_split="val", report_split="test",
+                   note=("CFFN: epochs = final softmax-classifier epochs (EDCN + CCA fixed before it); " if CFFN else "")
+                   + "val = their 0 Nm validation (50/class); test = 2 Nm at 0 dB (their eval noise); 4 Nm acc in test4_acc; reported = last epoch")
+    rec.d["test4_acc"] = {}
+    recs[run_idx] = rec
+    return rec
+
+
+def acc_ce(prob, y_oh):
+    y = np.argmax(y_oh, axis=1)
+    return float(np.mean(np.argmax(prob, axis=1) == y)), float(np.mean(-np.log(np.clip(prob[np.arange(len(y)), y], 1e-12, 1.0))))
+
+
+class _Base(tf.keras.callbacks.Callback):
+    def on_epoch_end(self, epoch, logs=None):
+        logs = logs or {}
+        a2, ce2 = acc_ce(self.prob(self.t2), self.t2[2])
+        a4, _ = acc_ce(self.prob(self.t4), self.t4[2])
+        self.rec.log(epoch + 1, "val", float(logs.get("val_accuracy", np.nan)), float(logs.get("val_loss", np.nan)))
+        self.rec.log(epoch + 1, "test", a2, ce2)
+        self.rec.d["test4_acc"][str(epoch + 1)] = a4
+        self.rec.d["last"] = epoch + 1
+
+
+class AuditCB(_Base):          # MHCNN / MSF-DFormer
+    def __init__(self, run_idx, seed, base_model, x2v, x2c, y2, x4v, x4c, y4):
+        super().__init__()
+        self.base = base_model
+        f, snr = G["add_noise_then_optional_post_zscore_np"], G["TRAIN_BASE_SNR_DB"]
+        rng = np.random.RandomState(seed + 999); self.t2 = (f(x2v, snr, rng), f(x2c, snr, rng), y2)
+        rng = np.random.RandomState(seed + 999); self.t4 = (f(x4v, snr, rng), f(x4c, snr, rng), y4)
+        self.rec = new_rec(run_idx, seed)
+
+    def prob(self, t):
+        return self.base.predict([t[0], t[1]], verbose=0)
+
+
+class AuditCFFN(_Base):        # CFFN final-classifier stage
+    def __init__(self, feat_v, feat_c, cca_params):
+        super().__init__()
+        c = AUDIT_CTX; seed = c["seed"]
+        f, snr = G["add_noise_then_optional_post_zscore_np"], G["TRAIN_BASE_SNR_DB"]
+        fused = []
+        for (xv, xc, y), s in ((c["x2"], seed + 10), (c["x4"], seed + 20)):
+            rng = np.random.RandomState(s)
+            xvn, xcn = f(xv, snr, rng), f(xc, snr, rng)
+            fv = feat_v.predict(xvn, batch_size=256, verbose=0); fc = feat_c.predict(xcn, batch_size=256, verbose=0)
+            fused.append((G["cca_transform"](fv, fc, cca_params), None, y))
+        self.t2, self.t4 = fused
+        self.rec = new_rec(c["run_idx"], seed)
+
+    def prob(self, t):
+        return self.model.predict(t[0], batch_size=256, verbose=0)
+
+
+T0 = time.time()
+
+
+def final(run_idx, seed, acc2, acc4):
+    rec = recs[run_idx]
+    rec.author_pick(rec.d["last"])     # no checkpointing: their reported model is the last epoch
+    rec.d["author_reported_4nm"] = float(acc4)
+    rec.finish(float(acc2))
+    print(json.dumps(dict(group=a.group, seed=seed, seconds=round(time.time() - T0, 1), author_epoch=rec.d["author_epoch"],
+                          reported=float(acc2), check=rec.d["author_check"])), flush=True)
+
+
+G.update(AUDIT_CB=(AuditCFFN if CFFN else AuditCB), AUDIT_FINAL=final, AUDIT_CTX=AUDIT_CTX)
+os.chdir(CODE)
+exec(compile(src, SCRIPT, "exec"), G)
