+"""[audit] Driver for object 36 (registry: results/main_objects/registry/36_*.md).
+Runs the authors' main.main() with the 4 README training commands (all --epochs 100 --num_classes 10), 10 unseeded
+repeats each; train.AUDIT_HOOK records the authors' per-epoch val (= report) acc/loss, AUDIT_FINAL their best_acc.
+Needs PYTHONPATH=~/audit_cns/code, AUDIT_RECORD_DIR; --data_dir is a root holding '12k Drive End Bearing Fault Data'."""
+import argparse, json, os, sys, time
+REPO = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, REPO)
+import main as M
+import train as T
+from audit.main.epoch_record import Recorder
+
+GROUPS = {"MC-SwinT+EDL-Digamma": ["--model", "mcswint", "--uncertainty", "--digamma"],
+          "1D-ViT+EDL-Log": ["--model", "vit", "--uncertainty", "--log"],
+          "LeNet+EDL-MSE": ["--model", "lenet", "--uncertainty", "--mse"],
+          "MC-SwinT+CE": ["--model", "mcswint"]}
+p = argparse.ArgumentParser()
+p.add_argument("--groups", default=",".join(GROUPS))
+p.add_argument("--repeats", default="0-9")
+p.add_argument("--epochs", type=int, default=100)
+p.add_argument("--data_dir", required=True)
+p.add_argument("--save_dir", required=True)
+a = p.parse_args()
+lo, hi = map(int, a.repeats.split("-")) if "-" in a.repeats else (int(a.repeats),) * 2
+
+for g in a.groups.split(","):
+    for r in range(lo, hi + 1):
+        rec = Recorder(obj="36", group=f"{g}|CWRU 1797", seed=r, select_split=None, report_split="test",
+                       note=f"unseeded repeat {r}; test = authors' val split (no separate test set)")
+        st = {"best": 0.0}
+
+        def hook(ep, acc, loss):
+            rec.log(ep, "test", acc, loss)
+            if acc > st["best"]:     # authors' rule (strict >)
+                st["best"] = acc; rec.author_pick(ep)
+
+        final = {}
+        T.AUDIT_HOOK, T.AUDIT_FINAL = hook, (lambda v: final.update(v=v))
+        sys.argv = ["main.py", "--train"] + GROUPS[g] + ["--data_dir", a.data_dir, "--num_classes", "10",
+                                                      "--epochs", str(a.epochs), "--save_dir", os.path.join(a.save_dir, g, str(r))]
+        t0 = time.time()
+        M.main()
+        T.AUDIT_HOOK = T.AUDIT_FINAL = None
+        rec.finish(final.get("v"))
+        print(json.dumps(dict(group=g, repeat=r, seconds=round(time.time() - t0, 1), author_epoch=rec.d["author_epoch"],
+                              reported=final.get("v"), check=rec.d["author_check"])), flush=True)
