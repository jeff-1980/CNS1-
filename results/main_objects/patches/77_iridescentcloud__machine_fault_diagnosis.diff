@@ -0,0 +1,47 @@
+"""[audit] Driver for object 77 (registry: results/main_objects/registry/77_iridescentcloud__machine_fault_diagnosis.md).
+Runs the authors' GACNN/train.py (runpy, cwd = GACNN/) with defaults (SEU bearingset, channel 0, 50 samples per class,
+FD input, complete graph of 10 nodes, train_size 0.6, GACNN_2, 100 epochs, Adam 1e-3) 10 times unseeded (their
+train_test_split has no random_state). The authors test only once after the last epoch; the hook evaluates their test
+loader after every epoch inside isolate() with their own test computation (node accuracy) and NLL. AUDIT_FINAL
+receives their final test accuracy. Needs PYTHONPATH with ~/audit_cns/code, AUDIT_RECORD_DIR."""
+import argparse, json, os, runpy, sys, time
+import torch, torch.nn.functional as F
+REPO = os.path.dirname(os.path.abspath(__file__))
+SRC = os.path.join(REPO, "GACNN")
+p = argparse.ArgumentParser()
+p.add_argument("--repeats", default="0-9")
+p.add_argument("--epochs", type=int, default=None)   # smoke only
+a = p.parse_args()
+lo, hi = map(int, a.repeats.split("-")) if "-" in a.repeats else (int(a.repeats),) * 2
+os.chdir(SRC); sys.path.insert(0, SRC)
+from audit.main.epoch_record import Recorder
+from audit.torch_utils import isolate
+import utils.train_utils as TU
+DATA = os.path.join(REPO, "SEU", "Mechanical-datasets-master", "gearbox", "bearingset")
+
+for r in range(lo, hi + 1):
+    rec = Recorder(obj="77", group="GACNN_2|SEU bearingset ch0 10-class", seed=r, select_split=None, report_split="test",
+                   note="unseeded repeat; their test runs once after the last epoch; per-epoch test evaluated by the "
+                        "audit in isolate() with their node-accuracy computation")
+
+    def hook(ep, model, loader_test, device):
+        with isolate([model], device):
+            model.eval()
+            correct, n, nll = 0, 0, 0.0
+            with torch.no_grad():
+                for d in loader_test:
+                    d = d.to(device); out = model(d)
+                    correct += (out.argmax(1) == d.y).sum().item(); n += d.y.numel()
+                    nll += F.nll_loss(out, d.y, reduction="sum").item()
+        rec.log(ep, "test", correct / n, nll / n)
+
+    final = {}
+    TU.AUDIT_HOOK = hook
+    TU.AUDIT_FINAL = lambda v: final.update(v=float(v))
+    sys.argv = ["train.py", "--dataset_path", DATA]
+    if a.epochs: sys.argv += ["--epochs", str(a.epochs)]
+    t0 = time.time()
+    runpy.run_path(os.path.join(SRC, "train.py"), run_name="__main__")
+    rec.finish(final.get("v"))   # author pick = last epoch (default)
+    print(json.dumps(dict(repeat=r, seconds=round(time.time() - t0, 1), author_epoch=rec.d["author_epoch"],
+                          reported=final.get("v"), check=rec.d["author_check"])), flush=True)
