+"""[audit] Driver for object 34 (registry: results/main_objects/registry/34_*.md).
+Runs the authors' main.py as __main__ (runpy) with --source DE --target FE --task DE-FE (defaults otherwise), once
+per unseeded repeat. AUDIT_HOOK records the authors' target accuracy each epoch and, isolated, the target
+cross-entropy; AUDIT_FINAL receives max_correct. Run with cwd = a work dir holding CWRU_dataset/ (extracted .npy)
+and record/. Needs PYTHONPATH=~/audit_cns/code and AUDIT_RECORD_DIR."""
+import argparse, json, os, runpy, sys, time
+REPO = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, REPO)
+import torch
+import torch.nn.functional as F
+from torch.utils.data import DataLoader
+from audit.main.epoch_record import Recorder
+from audit.torch_utils import isolate
+
+p = argparse.ArgumentParser()
+p.add_argument("--repeats", default="0-9")
+p.add_argument("--epochs", type=int, default=None)
+a = p.parse_args()
+lo, hi = map(int, a.repeats.split("-")) if "-" in a.repeats else (int(a.repeats),) * 2
+dev = torch.device("cuda")
+
+for r in range(lo, hi + 1):
+    rec = Recorder(obj="34", group="FRAN|CWRU DE->FE", seed=r, select_split=None, report_split="test",
+                   note=f"unseeded repeat {r}; test = authors' target-domain accuracy (all target samples)")
+    state = {"best": -1.0}
+
+    def hook(ep, netG, netF, correct, target_dataset):
+        with isolate([netG, netF], dev):
+            netG.eval(); netF.eval()
+            tot, n = 0.0, 0
+            with torch.no_grad():
+                for x, y in DataLoader(target_dataset, batch_size=256, shuffle=False):
+                    out = netF(netG(x.to(dev)))
+                    tot += F.cross_entropy(out, y.to(dev), reduction="sum").item(); n += y.size(0)
+        rec.log(ep, "test", float(correct), tot / n)
+        if correct >= state["best"]:   # authors' rule
+            state["best"] = correct; rec.author_pick(ep)
+
+    final = {}
+    g = dict(AUDIT_HOOK=hook, AUDIT_FINAL=lambda v: final.update(v=float(v)))
+    sys.argv = [os.path.join(REPO, "main.py"), "--source", "DE", "--target", "FE", "--task", "DE-FE"] + \
+               (["--epoch", str(a.epochs)] if a.epochs else [])
+    t0 = time.time()
+    runpy.run_path(os.path.join(REPO, "main.py"), init_globals=g, run_name="__main__")
+    rec.finish(final.get("v"))
+    print(json.dumps(dict(repeat=r, seconds=round(time.time() - t0, 1), author_epoch=rec.d["author_epoch"],
+                          reported=final.get("v"), check=rec.d["author_check"])), flush=True)
